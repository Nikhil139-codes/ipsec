# IPsec Analyzer Environment Configuration

# Backend API URL (Default: http://localhost:8000)
NEXT_PUBLIC_ANALYZER_API_URL=http://localhost:8000

# Set to 'false' to use the real Python + FastAPI + TShark backend
# Set to 'true' (or leave empty) to use mock simulation data
NEXT_PUBLIC_USE_MOCK_API=false

# Groq API Configuration (Server-Side Only - Never exposed to client browsers)
GROQ_API_KEY=gsk_...
GROQ_MODEL=groq/compound
